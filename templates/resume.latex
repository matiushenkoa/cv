\documentclass[11pt]{article}

\usepackage[margin=$if(margin)$$margin$$else$0.85in$endif$]{geometry}
\usepackage{iftex}
\ifPDFTeX
\else
  \usepackage{fontspec}
  \setmainfont{Helvetica Neue}[
    UprightFont = *,
    BoldFont = * Bold,
    ItalicFont = * Italic,
    BoldItalicFont = * Bold Italic
  ]
\fi
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{parskip}

\definecolor{heading}{HTML}{1B4F5C}
\definecolor{hrcolor}{HTML}{B0B0B0}

\hypersetup{colorlinks=true, linkcolor=heading, urlcolor=heading}
\urlstyle{same}

\newcommand{\fullrule}{\noindent{\color{hrcolor}\rule{\linewidth}{0.8pt}}}

\setlength{\parindent}{0pt}
\pagenumbering{arabic}

\titleformat{\section}
  {\color{heading}\Large\bfseries}{}{0pt}{}
  [{\vspace{-4pt}\fullrule}]
\titlespacing*{\section}{0pt}{16pt}{8pt}

\titleformat{\subsection}
  {\bfseries}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{2pt}

\titleformat{\subsubsection}
  {\bfseries}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{2pt}

\titleformat{\paragraph}[hang]
  {\color{heading}\bfseries\small}{}{0pt}{}
\titlespacing*{\paragraph}{0pt}{10pt}{4pt}

\setlist[itemize]{leftmargin=1.2em, itemsep=2pt, topsep=2pt, parsep=0pt}

\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\begin{document}

{\color{heading}\Huge\bfseries $name$\par}
\vspace{4pt}
{\bfseries $tagline$\par}
\vspace{4pt}
$location$ \quad$$|$$\quad LinkedIn: \href{$linkedin$}{$linkedin$}\par
\vspace{8pt}
\fullrule
\vspace{4pt}

$body$

\end{document}
